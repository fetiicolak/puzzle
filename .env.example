# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env git'e girmez; üretimde değerler GitHub Actions secrets'tan gelir
# (bkz. .github/workflows/deploy.yml).

# Supabase bağlantısı.
# Not: anon/publishable anahtar tarayıcıda çalışmak için tasarlanmıştır ve
# derlenmiş pakete zaten gömülür; gizli değildir. Veriyi koruyan şey
# supabase/schema.sql içindeki satır düzeyi güvenlik (RLS) kurallarıdır.
# service_role anahtarı ASLA buraya konmamalıdır.
VITE_SUPABASE_URL=https://ornek.supabase.co
VITE_SUPABASE_ANON_KEY=

# TURN (aktarma) sunucusu — doğrudan bağlantı kurulamayan ağlar için.
# Boş bırakılırsa açık kullanıma sunulmuş sunucular denenir.
# Adresleri virgülle ayırın.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
